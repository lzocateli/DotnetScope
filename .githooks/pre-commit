#!/bin/sh
set -eu

# Docker ou Podman (rootless); DOTNETSCOPE_CONTAINER_ENGINE forca um deles.
engine="${DOTNETSCOPE_CONTAINER_ENGINE:-}"
if [ -z "$engine" ]; then
  if command -v docker >/dev/null 2>&1; then
    engine=docker
  elif command -v podman >/dev/null 2>&1; then
    engine=podman
  fi
fi

if [ -z "$engine" ] || ! command -v "$engine" >/dev/null 2>&1; then
  echo "Gitleaks obrigatorio: Docker ou Podman nao foi encontrado no PATH." >&2
  exit 1
fi

git diff --cached --no-ext-diff --no-textconv | MSYS_NO_PATHCONV=1 "$engine" run --rm -i --read-only \
  --volume "$(git rev-parse --show-toplevel)/.gitleaks.toml:/gitleaks.toml:ro" \
  docker.io/lzocateli/gitleaks:8.30.1 \
  stdin --redact --config /gitleaks.toml
